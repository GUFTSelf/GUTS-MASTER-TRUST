{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VEK_Claim_Graph_Schema_v1",
  "description": "JSON schema for validating Claim-to-Implementation mappings, connecting USPTO patent applications to concrete source folders, classes, and Cargo assertions.",
  "type": "OBJECT",
  "properties": {
    "matrix_version": {
      "type": "STRING",
      "enum": ["1.0.0"]
    },
    "patent_applications": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "application_id": { "type": "STRING", "pattern": "^US19/\\d{3},\\d{3}$" },
          "title": { "type": "STRING" },
          "technology_family": { "type": "STRING" },
          "claims": {
            "type": "ARRAY",
            "items": {
              "type": "OBJECT",
              "properties": {
                "claim_number": { "type": "INTEGER", "minimum": 1 },
                "claim_type": { "type": "STRING", "enum": ["independent", "dependent"] },
                "description_excerpt": { "type": "STRING" },
                "mapped_source_files": {
                  "type": "ARRAY",
                  "items": { "type": "STRING" }
                },
                "test_assertions": {
                  "type": "ARRAY",
                  "items": {
                    "type": "OBJECT",
                    "properties": {
                      "test_name": { "type": "STRING" },
                      "test_file": { "type": "STRING" },
                      "assertion_type": { "type": "STRING" }
                    },
                    "required": ["test_name", "test_file", "assertion_type"]
                  }
                }
              },
              "required": ["claim_number", "claim_type", "description_excerpt", "mapped_source_files", "test_assertions"]
            }
          }
        },
        "required": ["application_id", "title", "technology_family", "claims"]
      }
    }
  },
  "required": ["matrix_version", "patent_applications"],
  "additionalProperties": false
}
