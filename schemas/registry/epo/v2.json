{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VEK_EPO_v2_Schema",
  "description": "JSON schema for validating Execution Proof Object (EPO) v2.1 structures with cryptographic seals.",
  "type": "object",
  "properties": {
    "epo_version": { "type": "string", "enum": ["2.1"] },
    "kernel_version": { "type": "string" },
    "domain": { "type": "string" },
    "execution_id": { "type": "string" },
    "seed": { "type": ["string", "number"] },
    "initial_state_hash": { "type": "string" },
    "final_state_hash": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "command": { "type": "string" },
          "payload_hash": { "type": "string" },
          "payload": { "type": "object" }
        },
        "required": ["step", "command", "payload_hash", "payload"]
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "prev_hash": { "type": "string" },
          "state_hash": { "type": "string" },
          "input_hash": { "type": "string" }
        },
        "required": ["step", "prev_hash", "state_hash", "input_hash"]
      }
    },
    "proof_hash": { "type": "string" },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": { "type": "string" },
        "public_key": { "type": "string" },
        "signature": { "type": "string" }
      },
      "required": ["algorithm", "public_key", "signature"]
    }
  },
  "required": [
    "epo_version",
    "kernel_version",
    "domain",
    "execution_id",
    "seed",
    "initial_state_hash",
    "final_state_hash",
    "inputs",
    "trace",
    "proof_hash",
    "signature"
  ]
}
